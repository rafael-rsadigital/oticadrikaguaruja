---
import '../styles/global.css';
const { title = 'Ótica Drika | Guarujá', description = 'Ótica Drika em Guarujá. Saúde, estilo e qualidade para sua visão. Consultora ótica com 15 anos de experiência.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#c91f32" />
<meta name="description" content={description} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href="https://oticadrikaguaruja.vercel.app/" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content="Ótica Drika" />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://oticadrikaguaruja.vercel.app/" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content="https://oticadrikaguaruja.vercel.app/eye-mark.svg" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<link rel="icon" type="image/svg+xml" href="/eye-mark.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<title>{title}</title>
</head>
<body><slot /></body>
</html>
