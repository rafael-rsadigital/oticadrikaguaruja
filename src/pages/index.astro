---
import BaseLayout from '../layouts/BaseLayout.astro';
const phone = '5513997309976';
const whatsapp = (message = 'Olá! Vim pelo link da Ótica Drika e gostaria de informações.') => 'https://wa.me/' + phone + '?text=' + encodeURIComponent(message);
const instagram = 'https://www.instagram.com/otica.drika/';
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('Ótica Drika, Rua Maria Geralda Valadão, 06, Parque Enseada, Guarujá, SP');
const review = 'https://search.google.com/local/writereview?placeid=ChIJg2nSpVwB0pQRZ5SyR6GczNA';
const links = [
 {label:'Fale com a Ótica Drika',sub:'Atendimento e dúvidas pelo WhatsApp',url:whatsapp(),icon:'whatsapp',primary:true},
 {label:'Instagram',sub:'Veja modelos, novidades e dicas',url:instagram,icon:'instagram'},
 {label:'Como chegar',sub:'Rua Maria Geralda Valadão, 06 · Guarujá',url:maps,icon:'pin'},
 {label:'Avalie nossa loja no Google',sub:'Sua opinião ajuda outras pessoas',url:review,icon:'google'},
];
const quick = [
 {label:'Óculos de sol',url:whatsapp('Olá! Gostaria de ver opções de óculos de sol.')},
 {label:'Armações de grau',url:whatsapp('Olá! Estou procurando armações de óculos de grau.')},
 {label:'Lentes e dúvidas',url:whatsapp('Olá! Gostaria de tirar dúvidas sobre lentes.')},
];
---
<BaseLayout>
<main class="page">
  <div class="ambient" aria-hidden="true"></div>
  <div class="container">
    <header class="profile">
      <div class="logo" aria-label="Ótica Drika">
        <svg viewBox="0 0 180 100" class="eye" role="img" aria-label="Símbolo de olho da Ótica Drika">
          <path class="eye-red" d="M12 50C38 18 68 8 90 8s52 10 78 42C142 82 112 92 90 92S38 82 12 50Z"/>
          <path class="eye-white" d="M25 50C46 28 70 20 90 20s44 8 65 30c-21 22-45 30-65 30S46 72 25 50Z"/>
          <circle class="iris" cx="90" cy="50" r="27"/>
          <circle class="pupil" cx="90" cy="50" r="14"/>
          <circle cx="79" cy="39" r="6" fill="#fff" opacity=".9"/>
          <path class="blue-detail" d="M62 27c18-12 38-12 56-4M119 73c-17 12-36 13-53 5"/>
        </svg>
        <div class="brand">Ótica <span>Drika</span></div>
      </div>
      <p class="tagline">Pensando sempre na sua visão</p>
      <div class="credentials"><span>SAÚDE</span><i></i><span>ESTILO</span><i></i><span>QUALIDADE</span></div>
      <p class="experience">Consultora Ótica · 15 anos de experiência</p>
    </header>
    <nav class="main-links" aria-label="Links da Ótica Drika">
      {links.map((link) => <a class:list={['link-card',link.primary && 'primary']} href={link.url} target="_blank" rel="noopener noreferrer">
        <span class="icon">
          {link.icon === 'whatsapp' && <svg class="whatsapp-svg" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.5a12.1 12.1 0 0 0-10.4 18.3L4 27.8l6.1-1.6A12.1 12.1 0 1 0 16 3.5Z" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"/><path d="M11.2 9.8c-.4 0-.8.1-1.1.5-.4.5-.9 1.2-.9 2.2 0 1.1.8 2.2 1 2.5.2.3 1.8 3 4.4 4.4.7.4 1.3.6 1.7.7.7.2 1.3.2 1.8.1.6-.1 1.7-.7 2-1.4.2-.6.2-1.2.1-1.4-.1-.2-.3-.3-.6-.4l-1.7-.8c-.3-.1-.5-.2-.6.2-.2.3-.7.8-.8 1-.2.2-.4.2-.6.1-.3-.1-1.1-.4-2.1-1.2-.8-.7-1.3-1.5-1.5-1.8-.2-.3 0-.4.1-.6l.4-.5c.2-.2.2-.4.3-.5.1-.2 0-.4 0-.5l-.8-1.8c-.2-.4-.4-.5-.7-.5h-.5Z" fill="currentColor" stroke="none"/></svg>}
          {link.icon === 'instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.6" cy="6.8" r=".8" fill="currentColor" stroke="none"/></svg>}
          {link.icon === 'pin' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5.2-8 12-8 12s-8-6.8-8-12a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.7"/></svg>}
          {link.icon === 'google' && <svg viewBox="0 0 24 24" aria-hidden="true"><text x="3" y="21" font-family="Arial,sans-serif" font-size="22" font-weight="700" fill="currentColor" stroke="none">G</text></svg>}
        </span>
        <span class="divider"></span><span class="link-copy"><strong>{link.label}</strong><small>{link.sub}</small></span><span class="arrow">›</span>
      </a>)}
    </nav>
    <section class="stories" aria-label="Fotos e vídeos da Ótica Drika">
      <div class="stories-heading"><span>Conheça a Ótica Drika</span><small>Fotos, novidades e produtos</small></div>
      <div class="story-carousel" data-story-carousel>
        <div class="story-progress" aria-hidden="true">
          {Array.from({length:11},(_,i)=><span class="story-progress-segment"><i></i></span>)}
        </div>
        <div class="story-slides">
          <img class="story-slide is-active zoom-in" src="/images/WhatsApp%20Image%202026-11-27%20at%2015.09.50%20(1).jpeg" alt="Ótica Drika — conteúdo enviado pela loja" fetchpriority="high" />
          <img class="story-slide zoom-out" src="/images/WhatsApp%20Image%202026-11-27%20at%2015.09.50%20(2).jpeg" alt="Ótica Drika — conteúdo enviado pela loja" loading="lazy" />
          <img class="story-slide zoom-in" src="/images/WhatsApp%20Image%202026-11-27%20at%2015.09.50.jpeg" alt="Ótica Drika — conteúdo enviado pela loja" loading="lazy" />
          <img class="story-slide zoom-out" src="/images/WhatsApp%20Image%202026-11-27%20at%2015.09.51.jpeg" alt="Ótica Drika — conteúdo enviado pela loja" loading="lazy" />
          <img class="story-slide zoom-in" src="/images/WhatsApp%20Image%202026-11-27%20at%2015.10.03.jpeg" alt="Ótica Drika — conteúdo enviado pela loja" loading="lazy" />
          <img class="story-slide zoom-out" src="/images/WhatsApp%20Image%202026-11-27%20at%2015.10.04.jpeg" alt="Ótica Drika — conteúdo enviado pela loja" loading="lazy" />
          <img class="story-slide zoom-in" src="/images/WhatsApp%20Image%202026-11-27%20at%2015.10.05%20(1).jpeg" alt="Ótica Drika — conteúdo enviado pela loja" loading="lazy" />
          <img class="story-slide zoom-out" src="/images/WhatsApp%20Image%202026-11-27%20at%2015.10.05%20(2).jpeg" alt="Ótica Drika — conteúdo enviado pela loja" loading="lazy" />
          <img class="story-slide zoom-in" src="/images/WhatsApp%20Image%202026-11-27%20at%2015.10.05%20(3).jpeg" alt="Ótica Drika — conteúdo enviado pela loja" loading="lazy" />
          <img class="story-slide zoom-out" src="/images/WhatsApp%20Image%202026-11-27%20at%2015.10.05.jpeg" alt="Ótica Drika — conteúdo enviado pela loja" loading="lazy" />
          <video class="story-slide story-video zoom-in" data-src="/videos/WhatsApp%20Video%202026-11-27%20at%2015.10.04.mp4" muted playsinline preload="none" aria-label="Vídeo da Ótica Drika"></video>
        </div>
        <button class="story-toggle" type="button" aria-label="Pausar carrossel" title="Pausar">Ⅱ</button>
      </div>
    </section>
    <section class="quick-section">
      <div class="section-heading"><span></span><h2>ENCONTRE O QUE PROCURA</h2><span></span></div>
      <div class="quick-links">
        {quick.map((item)=><a href={item.url} target="_blank" rel="noopener noreferrer" class="quick-card"><span>{item.label}</span><b>↗</b></a>)}
      </div>
    </section>
    <section class="location">
      <div class="map"><iframe src="https://maps.google.com/maps?q=Ótica%20Drika%2C%20Rua%20Maria%20Geralda%20Valadão%2C%2006%2C%20Parque%20Enseada%2C%20Guarujá%2C%20SP&output=embed" loading="lazy" title="Mapa da Ótica Drika em Guarujá" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
      <p class="hours"><span class="clock">◷</span> Segunda a sexta · 09h às 17h30 <span class="closed">Sábados e domingos: fechado</span></p>
    </section>
    <footer class="nap"><span>Ótica Drika</span><span class="footer-dot">•</span><span>Rua Maria Geralda Valadão, 06 · Parque Enseada, Guarujá – SP · 11443-070</span><span class="footer-dot">•</span><span>Seg–Sex 09h–17h30</span></footer>
    <div class="credit">Desenvolvido por <a href="https://wa.me/5513988507195?text=Ol%C3%A1%21%20Vim%20pelo%20link%20da%20%C3%93tica%20Drika%20e%20gostaria%20de%20conhecer%20o%20trabalho%20da%20RSA%20Digital." target="_blank" rel="noopener noreferrer">RSA Digital</a></div>
  </div>

    <a class="floating-whatsapp" href={whatsapp()} target="_blank" rel="noopener noreferrer" aria-label="Fale com a Ótica Drika pelo WhatsApp" title="Fale pelo WhatsApp">
      <svg class="whatsapp-svg" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.5a12.1 12.1 0 0 0-10.4 18.3L4 27.8l6.1-1.6A12.1 12.1 0 1 0 16 3.5Z" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"/><path d="M11.2 9.8c-.4 0-.8.1-1.1.5-.4.5-.9 1.2-.9 2.2 0 1.1.8 2.2 1 2.5.2.3 1.8 3 4.4 4.4.7.4 1.3.6 1.7.7.7.2 1.3.2 1.8.1.6-.1 1.7-.7 2-1.4.2-.6.2-1.2.1-1.4-.1-.2-.3-.3-.6-.4l-1.7-.8c-.3-.1-.5-.2-.6.2-.2.3-.7.8-.8 1-.2.2-.4.2-.6.1-.3-.1-1.1-.4-2.1-1.2-.8-.7-1.3-1.5-1.5-1.8-.2-.3 0-.4.1-.6l.4-.5c.2-.2.2-.4.3-.5.1-.2 0-.4 0-.5l-.8-1.8c-.2-.4-.4-.5-.7-.5h-.5Z" fill="currentColor" stroke="none"/></svg>
    </a>
</main>
<script type="application/ld+json" set:html={JSON.stringify({
 "@context":"https://schema.org","@type":"Optician","name":"Ótica Drika","url":"https://oticadrikaguaruja.vercel.app/","telephone":"+55 13 99730-9976","description":"Ótica em Guarujá com atendimento de consultora ótica com 15 anos de experiência. Saúde, estilo e qualidade para sua visão.","address":{"@type":"PostalAddress","streetAddress":"Rua Maria Geralda Valadão, 06, Parque Enseada","addressLocality":"Guarujá","addressRegion":"SP","postalCode":"11443-070","addressCountry":"BR"},"areaServed":{"@type":"City","name":"Guarujá"},"sameAs":[instagram],"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"17:30"}]
})} />
</BaseLayout>

<script>
const carousel = document.querySelector('[data-story-carousel]');
if (carousel) {
  const slides = [...carousel.querySelectorAll('.story-slide')];
  const progress = [...carousel.querySelectorAll('.story-progress-segment i')];
  const pauseButton = carousel.querySelector('.story-toggle');
  const videoSlide = carousel.querySelector('.story-video');
  const imageDuration = 4800;
  let current = 0, paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let timer, start = 0, remaining = imageDuration, videoDuration = imageDuration;
  const isVideo = (slide) => slide instanceof HTMLVideoElement;
  const stopVideo = () => { if (videoSlide) { videoSlide.pause(); videoSlide.currentTime = 0; } };
  const setSlide = (index) => {
    stopVideo();
    slides.forEach((slide,i) => {
      slide.classList.toggle('is-active', i === index);
      slide.classList.remove('zoom-in','zoom-out');
      slide.classList.add(i % 2 === 0 ? 'zoom-in' : 'zoom-out');
    });
    progress.forEach((bar,i) => { bar.style.transition='none'; bar.style.width=i<index?'100%':'0%'; });
    current=index;
    remaining=isVideo(slides[current])?videoDuration:imageDuration;
    if(isVideo(slides[current]) && videoSlide && !videoSlide.src) videoSlide.src=videoSlide.dataset.src;
    if(isVideo(slides[current]) && videoSlide) videoSlide.load();
    if(!paused) runProgress();
  };
  const runProgress = () => {
    clearTimeout(timer);
    const bar=progress[current];
    const dur=remaining;
    bar.style.transition='none';
    requestAnimationFrame(()=>{bar.style.transition='width '+dur+'ms linear';bar.style.width='100%';});
    start=Date.now();
    if(isVideo(slides[current])) {
      const v=slides[current];
      v.play().catch(()=>{});
      timer=window.setTimeout(()=>next(),dur);
    } else {
      timer=window.setTimeout(()=>next(),dur);
    }
  };
  const next=()=>{setSlide((current+1)%slides.length);};
  const previous=()=>{setSlide((current-1+slides.length)%slides.length);};
  const pause=()=>{
    if(paused)return;
    paused=true;clearTimeout(timer);
    remaining=Math.max(0,remaining-(Date.now()-start));
    progress[current].style.transition='none';
    progress[current].style.width=Math.min(100,(1-remaining/(isVideo(slides[current])?videoDuration:imageDuration))*100)+'%';
    if(isVideo(slides[current])) slides[current].pause();
    pauseButton.textContent='▶';pauseButton.setAttribute('aria-label','Continuar carrossel');pauseButton.title='Continuar';
  };
  const play=()=>{
    if(!paused)return;
    paused=false;pauseButton.textContent='Ⅱ';pauseButton.setAttribute('aria-label','Pausar carrossel');pauseButton.title='Pausar';
    if(isVideo(slides[current]) && slides[current].duration && Number.isFinite(slides[current].duration)) remaining=Math.max(250,(slides[current].duration-slides[current].currentTime)*1000);
    runProgress();
  };
  if(videoSlide){
    videoSlide.addEventListener('loadedmetadata',()=>{if(Number.isFinite(videoSlide.duration)){videoDuration=videoSlide.duration*1000;if(current===slides.indexOf(videoSlide)&&!paused){remaining=videoDuration;runProgress();}}});
    videoSlide.addEventListener('ended',()=>{if(!paused)next();});
  }
  pauseButton.addEventListener('click',(e)=>{e.stopPropagation();paused?play():pause();});
  carousel.addEventListener('click',(e)=>{if(e.target===pauseButton)return;clearTimeout(timer);remaining=isVideo(slides[current])?videoDuration:imageDuration;const b=carousel.getBoundingClientRect();setSlide(e.clientX-b.left<b.width/2?(current-1+slides.length)%slides.length:(current+1)%slides.length);});
  carousel.addEventListener('mouseenter',pause);carousel.addEventListener('mouseleave',play);
  if(!paused)runProgress();else pauseButton.textContent='▶';
}
</script>
