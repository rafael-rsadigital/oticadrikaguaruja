          <path class="eye-white" d="M25 50C46 28 70 20 90 20s44 8 65 30c-21 22-45 30-65 30S46 72 25 50Z"/>
          <circle class="iris" cx="90" cy="50" r="27"/>
          <circle class="pupil" cx="90" cy="50" r="14"/>
          <circle cx="79" cy="39" r="6" fill="#fff" opacity=".9"/>
          <path class="blue-detail" d="M62 27c18-12 38-12 56-4M119 73c-17 12-36 13-53 5"/>
        </svg>
        <div class="brand">Ótica <span>Drika</span></div>
