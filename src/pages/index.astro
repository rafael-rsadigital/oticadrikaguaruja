        <span class="icon">{link.icon === 'whatsapp' && <svg viewBox="0 0 32 32"><path d="M26.5 5.5A14.2 14.2 0 0 0 4.2 23.1L2.5 29l6.1-1.6A14.2 14.2 0 1 0 26.5 5.5Z"/><path d="M11 9.7c-.5-.9-1-.9-1.5-.9-.4 0-.9 0-1.3.6-.5.5-1.8 1.7-1.8 4.1s1.8 4.8 2 5.1c.3.4 3.5 5.5 8.7 7.1 4.3 1.4 5.2 1 6.1.9.9-.2 2.9-1.2 3.3-2.3.4-1.2.4-2.1.3-2.3-.1-.3-.5-.4-1.1-.7l-3.3-1.6c-.5-.2-.8-.3-1.1.3-.4.6-1.3 1.6-1.6 1.9-.3.3-.6.4-1.1.1-.5-.2-2.2-.8-4.2-2.6-1.6-1.4-2.7-3.2-3-3.7-.3-.5 0-.8.2-1.1l.8-.9c.3-.3.4-.6.6-.9.2-.4.1-.7 0-1.1L11 9.7Z"/></svg>}
        {link.icon === 'instagram' && <svg viewBox="0 0 32 32"><rect x="4" y="4" width="24" height="24" rx="7"/><circle cx="16" cy="16" r="5.5"/><circle cx="23.1" cy="8.9" r="1.3" fill="currentColor" stroke="none"/></svg>}
        {link.icon === 'pin' && <svg viewBox="0 0 32 36"><path d="M16 33S28 21.5 28 13A12 12 0 0 0 4 1a12 12 0 0 0-4 12c0 8.5 16 20 16 20Z" transform="translate(0 1)"/><circle cx="16" cy="13" r="4"/></svg>}
        {link.icon === 'google' && <span class="google-g">G</span>}
        </span>
        <span class="divider"></span><span class="link-copy"><strong>{link.label}</strong><small>{link.sub}</small></span><span class="arrow">›</span>
      </a>)}
    </nav>

    <section class="quick-section">
      <div class="section-heading"><span></span><h2>ENCONTRE O QUE PROCURA</h2><span></span></div>
      <div class="quick-links">
        {quick.map((item)=><a href={item.url} target="_blank" rel="noopener noreferrer" class="quick-card"><span>{item.label}</span><b>↗</b></a>)}
